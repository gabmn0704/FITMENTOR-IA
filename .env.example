# Copy to .env for local runs (never commit .env).

# Port uvicorn listens on inside the container (Render sets it; local default 8000).
PORT=8000

# Optional. With a key, /coach asks Claude (claude-haiku-5-5); without it, rule-based answers.
ANTHROPIC_API_KEY=

# Optional locally, required in production. Must match AI_SHARED_SECRET of the Java backend.
# With it set, /analyze and /coach require the X-Internal-Token header. Unset = no auth (dev only).
AI_SHARED_SECRET=
